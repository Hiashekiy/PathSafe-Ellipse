# ---------------------------------------------------------------------------
# PathSafe-EllipseNet (spec V3)
# Tracked: the current implementation, its config/tests, docs, reports, figures,
#          the delivered model checkpoint, and the logs of the runs that produced it.
# Ignored: user-provided input maps, the datasets (hundreds of MB, regenerable from
#          the tracked scripts + the original maps) and intermediate training runs.
# ---------------------------------------------------------------------------

# input maps + all generated data (source trajectories, distance-field version, caches)
data/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# temporary
*.tmp
~$*
_scratch_*

# training runs: only the delivered model (conft3) is tracked
runs_v3sdf/*
!runs_v3sdf/conft3/
!runs_v3sdf/conft3/**
# ... and inside it, "last" is a duplicate of the best checkpoint
runs_v3sdf/conft3/last.pt

# ad-hoc console captures are not tracked (the three kept run logs are listed below)
logs_v3sdf_*
!logs_v3sdf_conft3.out
!logs_v3sdf_connctl.out
!logs_v3sdf_train10k_e100.out
