# ---------------------------------------------------------------------------
# PathSafe-EllipseNet (spec V3)
# Tracked: implementation, config, tests, docs, figures/metrics, the delivered model
#          checkpoint and the logs of the runs that produced it.
# Ignored: user-provided maps, the datasets (regenerable from the tracked scripts)
#          and any additional training run.
# ---------------------------------------------------------------------------

data/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# temporary
*.tmp
~$*
_scratch_*

# only the delivered checkpoint is tracked; further runs stay local
checkpoints/*
!checkpoints/v3_best.pt
!checkpoints/v3_config.json
!checkpoints/v3_run_meta.json
!checkpoints/v3_train_log.csv
