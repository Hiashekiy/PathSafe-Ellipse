# ---------------------------------------------------------------------------
# PathSafe-Ellipse
# Only source, configs, docs, reports and figures are tracked.
# Everything below is either user-provided input, a regenerable cache, or a
# large binary that can be rebuilt from the tracked code + config.
# ---------------------------------------------------------------------------

# input maps + all generated data (processed caches, intermediate samples, splits)
data/

# run logs (per-shard logs, profiling output, scratch scripts)
logs/

# duplicate model snapshots (best checkpoint is tracked, "last" is regenerable)
outputs/checkpoints/ellipse_net_last*.pt

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# temporary
*.tmp
~$*

# V3 trajectory-level dataset: cached parsed maps, per-shard progress, run outputs
logs_train_v3/
data/cache_v3/

# trained checkpoints (regenerable from the tracked code + config; ~5 MB each)
runs_v3/

# scratch benchmarks
_scratch_*

# psen_v3 (spec V3) runs: checkpoints, per-run logs and the v3sdf distance-field
# version are regenerable from the tracked code + config (data/ is ignored above);
# the report figures under outputs_v3sdf/ are tracked.
runs_v3sdf/
logs_v3sdf*
